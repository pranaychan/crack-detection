NVIDIA_API_KEY=replace_with_your_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=deepseek-ai/deepseek-v4.1-flash
# Max wait for the NVIDIA call in ms (the whole request is also capped at 55 s)
NVIDIA_TIMEOUT_MS=40000

NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace_with_your_password
NEO4J_DATABASE=neo4j

# Supabase (free tier) for collected images. Server-side only: never prefix with NEXT_PUBLIC_.
# Run scripts/supabase.sql once in the Supabase SQL editor.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=replace_with_service_role_or_secret_key
SUPABASE_BUCKET=inspection-images

# Optional: semantic retrieval (same NVIDIA key/base URL as chat). Falls back to TF-IDF if unavailable.
# NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
# NVIDIA_EMBEDDING_INPUT_TYPE=none   # set only if your embedding model rejects the input_type field
# Optional: override pipeline weights / min scores, e.g. {"hybrid":{"weights":{"semantic":0.4},"minScore":0.3}}
# RETRIEVAL_CONFIG=
