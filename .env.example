# NVIDIA API Catalog / OpenAI-compatible endpoint
NVIDIA_API_KEY=replace_with_your_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=deepseek-ai/deepseek-v4.1-flash

# Neo4j connection (Aura URI usually starts neo4j+s://; local usually bolt://localhost:7687)
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace_with_your_password
NEO4J_DATABASE=neo4j

# Optional: disable database access for a demo that only uses the UI/API health check
# DEMO_MODE=false
